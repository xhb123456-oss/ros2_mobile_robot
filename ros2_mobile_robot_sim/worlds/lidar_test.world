<?xml version="1.0"?>
<sdf version="1.6">
  <world name="lidar_test">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor>
    </physics>
    <!-- At the initial robot pose, the wall's near face is 1.90 m ahead. -->
    <model name="test_wall">
      <static>true</static>
      <pose>2 0 0.5 0 0 0</pose>
      <link name="wall">
        <collision name="collision"><geometry><box><size>0.2 2 1</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2 2 1</size></box></geometry>
          <material><ambient>0.8 0.5 0.1 1</ambient><diffuse>0.8 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
