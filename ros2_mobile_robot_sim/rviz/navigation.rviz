Panels:
- Class: rviz_common/Displays
  Name: Displays
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.7
    Class: rviz_default_plugins/Grid
    Name: Grid
    Enabled: true
    Value: true
    Cell Size: 0.5
    Plane Cell Count: 20
  - Class: rviz_default_plugins/Map
    Name: Map
    Enabled: true
    Value: true
    Alpha: 0.8
    Color Scheme: map
    Draw Behind: true
    Topic:
      Value: /map
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
    Use Timestamp: false
  - Class: rviz_default_plugins/RobotModel
    Name: RobotModel
    Enabled: true
    Value: true
    Alpha: 1
    Visual Enabled: true
    Collision Enabled: false
    Description Source: Topic
    Description Topic:
      Value: /robot_description
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
    Value: true
    Marker Scale: 0.25
    Show Names: false
    Show Axes: true
    Show Arrows: false
  - Class: rviz_default_plugins/LaserScan
    Name: LaserScan
    Enabled: true
    Value: true
    Topic:
      Value: /scan
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Filter size: 10
    Position Transformer: XYZ
    Color Transformer: FlatColor
    Color: 255; 60; 60
    Alpha: 1
    Style: Points
    Size (Pixels): 5
    Size (m): 0.03
    Decay Time: 0
    Use Fixed Frame: true
  - Class: rviz_default_plugins/Path
    Name: Global Path
    Enabled: true
    Value: true
    Alpha: 1
    Color: 50; 255; 80
    Buffer Length: 1
    Line Style: Lines
    Line Width: 0.03
    Pose Style: None
    Topic:
      Value: /plan
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Filter size: 10
  - Class: rviz_default_plugins/Path
    Name: Local Path
    Enabled: true
    Value: true
    Alpha: 1
    Color: 50; 200; 255
    Buffer Length: 1
    Line Style: Lines
    Line Width: 0.03
    Pose Style: None
    Topic:
      Value: /local_plan
      Depth: 5
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Volatile
      Filter size: 10
  - Class: rviz_default_plugins/Map
    Name: Global Costmap
    Enabled: false
    Value: false
    Alpha: 0.4
    Color Scheme: costmap
    Draw Behind: false
    Use Timestamp: false
    Topic:
      Value: /global_costmap/costmap
      Depth: 1
      History Policy: Keep Last
      Reliability Policy: Reliable
      Durability Policy: Transient Local
  Global Options:
    Fixed Frame: map
    Background Color: 35; 35; 35
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Target Frame: <Fixed Frame>
      Distance: 11
      Pitch: 1.45
      Yaw: 0.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0
